# Configuration SQL Analyzer
# Copier ce fichier en .env et remplir les valeurs

# Clé API Groq (obligatoire)
# Obtenir une clé sur: https://console.groq.com/keys
GROQ_API_KEY=gsk_clé_api

# Chemin vers la base de données SQLite (optionnel, peut être passé en paramètre)
DB_PATH=./etl/elections.db

# Modèle Groq à utiliser (optionnel)
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── Langfuse Observability (optionnel) ─────────────────────────────────────
# Obtenir les clés sur: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Laisser vide pour utiliser le cloud Langfuse (défaut)
# Mettre l'URL de votre instance self-hosted si applicable
LANGFUSE_HOST=https://cloud.langfuse.com

# Seuil en ms au-delà duquel une requête est flaggée "slow" dans les traces
SLOW_REQUEST_THRESHOLD_MS=15000
